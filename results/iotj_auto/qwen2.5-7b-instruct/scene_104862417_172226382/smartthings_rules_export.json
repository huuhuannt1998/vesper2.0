[
  {
    "name": "bedroom_motion_light",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "motionSensor",
                "attribute": "motion"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "command": {
                "devices": [
                  "*"
                ],
                "commands": [
                  {
                    "component": "main",
                    "capability": "switch",
                    "command": "on"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "name": "bathroom_water_leak_alert",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "waterSensor",
                "attribute": "water"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "notify": {
                "message": "Water leak detected in bathroom."
              }
            }
          ]
        }
      }
    ]
  },
