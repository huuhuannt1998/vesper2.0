[
  {
    "name": "laundryroom_motion_light",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "motionSensor",
                "attribute": "motion"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "notify": {
                "message": "Motion detected in laundryroom/mudroom after 6pm."
              }
            }
          ]
        }
      }
    ]
  },
