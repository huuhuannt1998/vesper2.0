                "attribute": "switch"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "command": {
                "devices": [
                  "*"
                ],
                "commands": [
                  {
                    "component": "main",
                    "capability": "switch",
                    "command": "off"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
