[
  {
    "name": "outdoor_motion_alert",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "motionSensor",
                "attribute": "motion"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "notify": {
                "message": "Motion detected outside at night"
              }
            }
          ]
        }
      }
    ]
  },
  {
    "name": "porch_motion_light",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
