[
  {
    "name": "entryway_unlock_light",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "motionSensor",
                "attribute": "motion"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "command": {
                "devices": [
                  "*"
                ],
                "commands": [
                  {
                    "component": "main",
                    "capability": "lock",
                    "command": "unlock"
                  }
                ]
              }
            },
            {
              "command": {
                "devices": [
                  "*"
                ],
                "commands": [
                  {
                    "component": "main",
                    "capability": "switch",
                    "command": "on"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
