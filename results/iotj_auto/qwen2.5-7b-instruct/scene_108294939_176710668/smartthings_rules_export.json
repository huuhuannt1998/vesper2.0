  {
    "name": "bathroom_water_leak",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "waterSensor",
                "attribute": "water"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "notify": {
                "message": "Water leak detected in bathroom!"
              }
            }
          ]
        }
      }
    ]
  },
  {
