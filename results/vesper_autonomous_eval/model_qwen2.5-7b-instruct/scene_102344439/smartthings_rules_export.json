[
  {
    "name": "hallway_motion_light",
    "actions": [
      {
        "if": {
          "equals": {
            "left": {
              "device": {
                "devices": [
                  "*"
                ],
                "component": "main",
                "capability": "motionSensor",
                "attribute": "motion"
              }
            },
            "right": {
              "string": "active"
            }
          },
          "then": [
            {
              "command": {
                "devices": [
                  "*"
                ],
                "commands": [
                  {
                    "component": "main",
                    "capability": "switch",
                    "command": "on"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
